# ==============================================================================
# กันไฟล์ภายในไม่ให้ใครโหลดผ่านเว็บ
# ==============================================================================
# ⚠️⚠️ ไฟล์นี้สำคัญมาก — ถ้าหายไป `.env` (รหัสฐานข้อมูล + รหัสอีเมล) จะถูกดาวน์โหลด
# ได้ด้วยการพิมพ์ https://โดเมน/.env ในเบราว์เซอร์เฉย ๆ
#
# บนโฮสต์ที่ไม่อ่าน .htaccess (nginx) ไฟล์นี้ไม่มีผลเลย ต้องไปตั้งที่ตัวเซิร์ฟเวอร์แทน
# Apache / LiteSpeed (Hostinger, cPanel ส่วนใหญ่) อ่านให้อัตโนมัติ
#
# ✅ หลัง deploy ต้องเปิด https://โดเมน/.env ดูด้วยตาว่าได้ 403 จริง — อย่าเชื่อว่าไฟล์นี้ทำงานเอง

# ── ปิดการแสดงรายชื่อไฟล์ในโฟลเดอร์ ─────────────────────────────────────────
Options -Indexes

# ── หน้าแจ้งข้อผิดพลาดของเราเอง ──────────────────────────────────────────────
# เดิมไม่มีบรรทัดพวกนี้เลย ผู้ใช้ที่เปิดลิงก์ผิด/ลิงก์เก่าจะเจอหน้าเปล่าภาษาอังกฤษ
# ของเซิร์ฟเวอร์ ไม่มีเมนู ไม่มีทางกลับ — คนที่ไม่ถนัดคอมจะคิดว่าเว็บพังทั้งเว็บ
#
# ⚠️ `error.php` ตั้งใจไม่เรียก bootstrap.php เพราะต้องขึ้นได้แม้ตอนที่ระบบพังจนตอบ 500
# ⚠️ ต้องเป็นพาธนำหน้าด้วย / (พาธจากรากเว็บ) ไม่ใช่ URL เต็ม ไม่งั้น Apache จะเปลี่ยน
#    เป็น redirect แล้วรหัสสถานะจริงหายไป (กลายเป็น 302 → 200)
#
# ⚠️⚠️ พาธของ `ErrorDocument` นับจาก **รากของโดเมน** ไม่ใช่โฟลเดอร์ของแอป
#    · บน Hostinger รากโปรเจกต์ = public_html/ ค่านี้จึงถูกต้องอยู่แล้ว
#    · แต่ถ้าติดตั้งในโฟลเดอร์ย่อย (เช่น http://โดเมน/ad-profit/ ตามคู่มือตอนพัฒนา)
#      พาธนี้จะชี้ออกนอกแอป → เปิดลิงก์ผิดแล้วเจอหน้า 404 ภาษาอังกฤษของ Apache
#    · Apache ไม่รับพาธแบบสัมพัทธ์ตรงนี้ — ทดลองกับ Apache จริงแล้วทั้ง `error.php`
#      และ `./error.php` ถูกตีความเป็น **ข้อความ** แล้วพิมพ์คำว่า "error.php"
#      ออกมาเป็นเนื้อหาทั้งหน้า จึงตั้งให้อัตโนมัติผ่านบรรทัดนี้ไม่ได้
#    · **กรณี 404 จึงไปใช้ mod_rewrite แทน** (ดูหัวข้อถัดไป) ซึ่งรับพาธสัมพัทธ์ได้
#      บรรทัดพวกนี้ยังเก็บไว้เป็นด่านสำรองสำหรับ 403/500 และสำหรับโฮสต์ที่ไม่มี
#      mod_rewrite — ติดตั้งที่รากโดเมนเมื่อไหร่ก็ถูกต้องทั้งสามรหัส
ErrorDocument 403 /error.php
ErrorDocument 404 /error.php
ErrorDocument 500 /error.php

# ── โฟลเดอร์ภายในทั้งหมด ─────────────────────────────────────────────────────
# ⚠️ ต้องกันที่นี่ด้วย ไม่ใช่พึ่ง .htaccess ในแต่ละโฟลเดอร์อย่างเดียว
# `vendor/` `logs/` `uploads/` ถูก .gitignore ไว้ ไฟล์ .htaccess ข้างในจึงอาจไม่ถูก
# อัปโหลดขึ้นไปด้วย (เช่นตอน deploy ด้วย git หรือ composer install บนเซิร์ฟเวอร์)
# กฎตรงนี้อยู่ในไฟล์เดียวที่ขึ้นไปแน่ ๆ จึงเป็นด่านที่เชื่อถือได้
#
# เปิดให้เข้าถึงเฉพาะ: หน้าเว็บที่รากโปรเจกต์ และ api/
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|cron|database|docs|includes|logs|tests|tools|uploads|vendor)/ - [F,L]

    # ── ลิงก์ที่ไม่มีอยู่จริง → หน้าแจ้งข้อผิดพลาดของเราเอง ──────────────────
    # ⚠️⚠️ ทำที่นี่แทน `ErrorDocument 404` เพราะพาธตรงนี้ **สัมพัทธ์กับโฟลเดอร์
    #    ที่ไฟล์ .htaccess อยู่** จึงถูกต้องทั้งตอนติดตั้งที่รากโดเมนและในโฟลเดอร์ย่อย
    #    โดยไม่ต้องแก้ไฟล์ตามที่ติดตั้ง (ต่างจาก ErrorDocument ที่นับจากรากโดเมนเสมอ)
    #
    # ⚠️ เงื่อนไข 2 บรรทัดสำคัญมาก — ถ้าไม่มี ทุกคำขอจะถูกส่งไปหน้า error ทั้งหมด
    #    รวมถึงหน้าเว็บและ api/ ที่มีอยู่จริง = เว็บพังทั้งเว็บ
    #
    # ⚠️ ต้องอยู่ **หลัง** กฎปิดโฟลเดอร์ภายในข้างบน ไม่งั้นคำขอไปยังโฟลเดอร์ที่ถูก
    #    .gitignore ไว้ (ซึ่งอาจไม่มีอยู่บนเซิร์ฟเวอร์) จะกลายเป็น 404 แทน 403
    #
    # ⚠️ ไม่ต้องบอกรหัส 404 ตรงนี้ — `error.php` ตอบ 404 เป็นค่าปริยายอยู่แล้ว
    #    เมื่อไม่มี REDIRECT_STATUS ที่รู้จัก (ยืนยันกับ Apache จริงแล้วว่าได้ 404)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ error.php [L]
</IfModule>

# ── ไฟล์ที่ขึ้นต้นด้วยจุด (.env, .git*, .htaccess เอง) ───────────────────────
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── ไฟล์ตามนามสกุลที่ไม่ควรเสิร์ฟ ────────────────────────────────────────────
# .sql = โครงสร้างฐานข้อมูล · .json/.lock = รายการไลบรารีไว้ให้คนหาช่องโหว่
# .md = เอกสารภายใน · .neon/.xml/.yml = ไฟล์ตั้งค่าเครื่องมือ · .log = บันทึกของระบบ
# ⚠️ โปรเจกต์นี้ไม่มีไฟล์ static ที่หน้าเว็บต้องโหลดเลย (ใช้ CDN ทั้งหมด)
#    ถ้าอนาคตเพิ่มไฟล์ .json/.xml ที่ต้องให้เบราว์เซอร์โหลด ต้องยกเว้นไว้ตรงนี้
<FilesMatch "\.(env|sql|lock|json|md|neon|xml|dist|ini|log|sh|bak|yml|yaml|sqlite|db)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
