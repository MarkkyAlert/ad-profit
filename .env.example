# ==============================================================================
# Ad-Profit Environment Configuration / ไฟล์ตั้งค่าระบบ
# ==============================================================================
# คัดลอกไฟล์นี้เป็น .env แล้วตั้งค่าตามความเหมาะสม
# Copy this file to .env and configure as needed
# ==============================================================================

# ------------------------------------------------------------------------------
# โหมดแอปพลิเคชัน (Application Environment)
# ------------------------------------------------------------------------------
# ค่าที่ใช้ได้: development | production
# - development = โหมดพัฒนา (แสดง error บนหน้าเว็บ, เปิดฟีเจอร์ debug)
# - production  = โหมดใช้งานจริง (ซ่อน error, บังคับ HTTPS)
#
# [PRODUCTION] ⚠️ ต้องตั้งเป็น production และต้องใช้ HTTPS
#              เพราะ session cookie จะถูกบังคับเป็น Secure เสมอ
APP_ENV=development

# ------------------------------------------------------------------------------
# ชื่อแอปพลิเคชัน (Application Name)
# ------------------------------------------------------------------------------
# ชื่อที่แสดงในหัวเว็บและอีเมล
APP_NAME="Ad Profit"

# ------------------------------------------------------------------------------
# URL ของแอปพลิเคชัน (Application URL)
# ------------------------------------------------------------------------------
# URL แบบเต็มของเว็บไซต์ (ไม่ต้องมี / ปิดท้าย)
# ตัวอย่าง: https://example.com หรือ https://example.com/ad-profit
#
# [DEVELOPMENT] สามารถเว้นว่างได้ (ระบบจะเดา path อัตโนมัติ)
# [PRODUCTION]  ⚠️ ต้องระบุ URL เต็ม และต้องเป็น https://
#               ถ้าไม่ตั้ง ระบบลืมรหัสผ่านจะใช้งานไม่ได้
APP_URL=

# ------------------------------------------------------------------------------
# เขตเวลา (Timezone)
# ------------------------------------------------------------------------------
# เขตเวลาที่ใช้ในระบบ (ดูรายการได้ที่ https://www.php.net/manual/en/timezones.php)
APP_TIMEZONE=Asia/Bangkok

# ------------------------------------------------------------------------------
# การตั้งค่าฐานข้อมูล (Database Configuration)
# ------------------------------------------------------------------------------
# [PRODUCTION] ⚠️ ต้องตั้งค่าให้ตรงกับ DB จริงบน server
#
# DB_HOST    = ที่อยู่เซิร์ฟเวอร์ DB (ปกติ 127.0.0.1 หรือ localhost)
# DB_PORT    = พอร์ต MySQL/MariaDB (ค่าเริ่มต้น 3306)
# DB_NAME    = ชื่อฐานข้อมูล
# DB_CHARSET = ชุดตัวอักษร (แนะนำ utf8mb4 สำหรับภาษาไทย/อีโมจิ)
# DB_USER    = ชื่อผู้ใช้ DB
# DB_PASS    = รหัสผ่าน DB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ad_profit
DB_CHARSET=utf8mb4
DB_USER=root
DB_PASS=

# ------------------------------------------------------------------------------
# การจำกัดอัตราการร้องขอ (Rate Limiting)
# ------------------------------------------------------------------------------
# ใช้ป้องกันการโจมตีแบบ brute-force (ลองรหัสผ่านซ้ำ ๆ)
#
# RATE_LIMIT_MAX_ATTEMPTS     = จำนวนครั้งสูงสุดที่ลองได้ก่อนถูกบล็อก
# RATE_LIMIT_WINDOW_SECONDS   = ช่วงเวลาที่นับ (วินาที)
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# เปลี่ยนอีเมล: ส่งลิงก์ยืนยันได้ไม่เกิน 1 ครั้งต่อ cooldown และไม่เกิน 5 ครั้งต่อชั่วโมงต่อผู้ใช้
# EMAIL_CHANGE_RESEND_COOLDOWN_SECONDS = เวลารอขั้นต่ำก่อนส่งลิงก์ซ้ำ (วินาที)
# EMAIL_CHANGE_RESEND_MAX_ATTEMPTS     = จำนวนครั้งสูงสุดในหน้าต่างยาว
# EMAIL_CHANGE_RESEND_WINDOW_SECONDS   = หน้าต่างยาวที่นับจำนวนครั้ง (วินาที)
EMAIL_CHANGE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CHANGE_RESEND_MAX_ATTEMPTS=5
EMAIL_CHANGE_RESEND_WINDOW_SECONDS=3600

# เพดาน "ต่อบัญชี" — นับรหัสผิดของบัญชีนี้รวมทุกเครื่อง (สองค่าบนผูกกับ IP
# คนร้ายที่หมุนเปลี่ยน IP จึงเลี่ยงได้) · เกินแล้ว **หน่วงเวลา** ไม่ใช่ปฏิเสธ
# เจ้าของบัญชีที่พิมพ์รหัสถูกจึงเข้าได้เสมอ และคนร้ายล็อกบัญชีคนอื่นทิ้งไม่ได้
# LOGIN_ACCOUNT_MAX_ATTEMPTS   = ผิดกี่ครั้งจึงเริ่มหน่วง
# LOGIN_ACCOUNT_WINDOW_SECONDS = ช่วงเวลาที่นับ (วินาที)
# LOGIN_ACCOUNT_MAX_DELAY_MS   = หน่วงได้นานสุดกี่มิลลิวินาที
#   ⚠️ ระหว่างหน่วง คำขอนั้นยึด PHP worker ไว้ · โฮสต์แบบแชร์มี worker จำกัด
#   ตั้งนานเกินไป = คนร้ายล่มเว็บได้ด้วยการเดารหัส (แย่กว่าปัญหาที่ตั้งใจแก้)
LOGIN_ACCOUNT_MAX_ATTEMPTS=20
LOGIN_ACCOUNT_WINDOW_SECONDS=900
LOGIN_ACCOUNT_MAX_DELAY_MS=1500

# ------------------------------------------------------------------------------
# การหมดเวลา Session (Session Timeout)
# ------------------------------------------------------------------------------
# ควบคุมว่าผู้ใช้จะถูก logout เมื่อไหร่
#
# SESSION_IDLE_TIMEOUT_SECONDS     = หมดเวลาเมื่อไม่มีการใช้งาน (วินาที)
#                                    ค่าเริ่มต้น 14400 = 4 ชั่วโมง
# SESSION_ABSOLUTE_TIMEOUT_SECONDS = หมดเวลาแบบเด็ดขาด นับจาก login (วินาที)
#                                    ค่าเริ่มต้น 86400 = 24 ชั่วโมง
SESSION_IDLE_TIMEOUT_SECONDS=14400
SESSION_ABSOLUTE_TIMEOUT_SECONDS=86400

# ------------------------------------------------------------------------------
# Schema Guard (ตรวจโครงสร้าง DB)
# ------------------------------------------------------------------------------
# เมื่อเปิดใช้งาน ระบบจะตรวจว่า DB มีตาราง/คอลัมน์ครบตามที่โค้ดต้องการหรือไม่
# ถ้าไม่ครบจะขึ้นหน้า 503 แทนที่จะพังแบบเงียบ ๆ
#
# [PRODUCTION] ⚠️ แนะนำให้เปิดไว้ (true) เสมอ
SCHEMA_GUARD_ENABLED=true

# ------------------------------------------------------------------------------
# Reverse Proxy (สำหรับเว็บที่อยู่หลัง Load Balancer/CDN)
# ------------------------------------------------------------------------------
# ใช้เมื่อเว็บอยู่หลัง proxy เช่น Cloudflare, AWS ELB, nginx reverse proxy
# เพื่อให้ระบบอ่าน IP จริงของผู้ใช้ได้ถูกต้อง
#
# TRUST_PROXY     = เปิดใช้การอ่าน IP จาก header (true/false)
# TRUSTED_PROXIES = รายการ IP ของ proxy ที่เชื่อถือ (คั่นด้วย ,)
#
# ⚠️ อย่าเปิดถ้าไม่ได้อยู่หลัง proxy เพราะจะทำให้ระบบถูกหลอก IP ได้
TRUST_PROXY=false
TRUSTED_PROXIES=

# ------------------------------------------------------------------------------
# แสดงลิงก์รีเซ็ตรหัสผ่านบนหน้าเว็บ (Dev Only)
# ------------------------------------------------------------------------------
# เมื่อเปิด (true) และเป็นโหมด development ระบบจะแสดงลิงก์รีเซ็ตบนหน้า
# forgot-password.php โดยไม่ต้องส่งอีเมล (สะดวกสำหรับทดสอบ)
#
# [PRODUCTION] ⚠️ ห้ามเปิด (ต้องเป็น false) เพราะเป็นช่องโหว่ความปลอดภัย
EXPOSE_DEV_RESET_LINK=false

# ------------------------------------------------------------------------------
# นโยบายรหัสผ่าน (Password Policy)
# ------------------------------------------------------------------------------
# PASSWORD_MIN_LENGTH = ความยาวขั้นต่ำของรหัสผ่าน (ตัวอักษร)
PASSWORD_MIN_LENGTH=8

# ------------------------------------------------------------------------------
# การรีเซ็ตรหัสผ่าน (Password Reset)
# ------------------------------------------------------------------------------
# PASSWORD_RESET_TOKEN_TTL_HOURS = อายุของลิงก์รีเซ็ตรหัสผ่าน (ชั่วโมง)
#                                  หลังจากนี้ลิงก์จะหมดอายุ
PASSWORD_RESET_TOKEN_TTL_HOURS=1

# ------------------------------------------------------------------------------
# ไฟล์บันทึก Error (Error Log Path)
# ------------------------------------------------------------------------------
# ที่เก็บไฟล์ log เมื่อเกิด error
# ตัวอย่าง: logs/php-error.log หรือ /var/log/ad-profit/error.log
#
# [DEVELOPMENT] เว้นว่างได้ (ระบบจะเก็บใน Temp ของเครื่อง)
# [PRODUCTION]  ⚠️ แนะนำให้ตั้ง path ที่อยู่นอก web root
#               เพื่อป้องกันไม่ให้คนอื่นดาวน์โหลด log ได้
LOG_FILE=

# ------------------------------------------------------------------------------
# การตั้งค่าอีเมล (Email Configuration - Gmail SMTP)
# ------------------------------------------------------------------------------
# ใช้สำหรับส่งอีเมลรีเซ็ตรหัสผ่าน
#
# [PRODUCTION] ⚠️ ถ้าต้องการใช้ฟีเจอร์ลืมรหัสผ่าน ต้องตั้งค่าให้ครบ
#
# MAIL_ENABLED       = เปิด/ปิดการส่งอีเมล (true/false)
# MAIL_HOST          = เซิร์ฟเวอร์ SMTP (เช่น smtp.gmail.com)
# MAIL_PORT          = พอร์ต SMTP (587 สำหรับ TLS, 465 สำหรับ SSL)
# MAIL_TIMEOUT_SECONDS = timeout การเชื่อมต่อ (วินาที)
# MAIL_RETRY_ATTEMPTS  = จำนวนครั้งที่ลองส่งใหม่เมื่อส่งไม่สำเร็จ
# MAIL_USERNAME      = อีเมลที่ใช้ส่ง (เช่น your-email@gmail.com)
# MAIL_PASSWORD      = รหัสผ่านหรือ App Password
#                      (สำหรับ Gmail ต้องใช้ App Password ดูที่ https://support.google.com/accounts/answer/185833)
# MAIL_FROM_ADDRESS  = อีเมลที่แสดงในช่อง From
# MAIL_FROM_NAME     = ชื่อที่แสดงในช่อง From
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_TIMEOUT_SECONDS=15
MAIL_RETRY_ATTEMPTS=1
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="Ad Profit"

# ==============================================================================
# สรุปสิ่งที่ต้องตั้งค่าสำหรับ Production
# ==============================================================================
# 1. APP_ENV=production
# 2. APP_URL=https://your-domain.com (URL เต็ม, ต้องเป็น https)
# 3. DB_HOST, DB_NAME, DB_USER, DB_PASS (ตั้งตาม DB จริงบน server)
# 4. EXPOSE_DEV_RESET_LINK=false (ห้ามเปิด)
# 5. LOG_FILE (แนะนำให้ตั้ง path นอก web root)
# 6. MAIL_* (ถ้าต้องการใช้ฟีเจอร์ลืมรหัสผ่าน ต้องตั้งค่าให้ครบ)
# 7. ต้องใช้ HTTPS (ถ้าไม่ใช้ session จะไม่ทำงาน)
# ==============================================================================
