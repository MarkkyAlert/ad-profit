# Application Environment
# development | production
APP_ENV=production

# Application Name
APP_NAME="Ad Profit"

# Application URL (required in production, e.g. https://example.com)
APP_URL=

# Timezone
APP_TIMEZONE=Asia/Bangkok

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ad_profit
DB_CHARSET=utf8mb4
DB_USER=root
DB_PASS=

# Rate Limiting
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Session Timeout (seconds)
SESSION_IDLE_TIMEOUT_SECONDS=14400
SESSION_ABSOLUTE_TIMEOUT_SECONDS=86400

# Schema Guard (fail fast when DB schema is outdated)
SCHEMA_GUARD_ENABLED=true

# Reverse Proxy (set true only when behind trusted proxy/load balancer)
TRUST_PROXY=false
# Trusted proxy IPs (comma-separated) used when TRUST_PROXY=true
TRUSTED_PROXIES=

# Expose reset-link token on forgot-password page in development (for local testing only)
EXPOSE_DEV_RESET_LINK=false

# Password Policy
PASSWORD_MIN_LENGTH=8

# Password Reset
PASSWORD_RESET_TOKEN_TTL_HOURS=1

# Error Log Path (recommended outside web root)
LOG_FILE=

# Email Configuration (Gmail SMTP)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_TIMEOUT_SECONDS=15
MAIL_RETRY_ATTEMPTS=1
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="Ad Profit"
